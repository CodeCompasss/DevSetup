        "install": {
          "choco": "choco install brave --pre ",
          "winget": "winget install --id=Brave.Brave  -e",
          "scoop": "scoop bucket add extras \nscoop install extras/brave",
          "apt": "sudo apt install curl\n\nsudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg\n\nsudo curl -fsSLo /etc/apt/sources.list.d/brave-browser-release.sources https://brave-browser-apt-release.s3.brave.com/brave-browser.sources\n\nsudo apt update\n\nsudo apt install brave-browser",
          "dnf": "sudo dnf install dnf-plugins-core  sudo dnf config-manager addrepo --from-repofile=https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo  sudo dnf install brave-browser",
          "pacman": "sudo pacman -Sy brave-browser",
          "homebrew": "brew install --cask brave-browser"
        }
